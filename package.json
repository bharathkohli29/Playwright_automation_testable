{
  "name": "testable-merge-flow",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "playwright test",
    "setup": "playwright test tests/auth.setup.ts",
    "s3": "playwright test --project=s3 --no-deps",
    "queue": "node queue-server/server.js",
    "sp:login": "tsx utils/spLogin.ts",
    "post": "tsx utils/postprocessCli.ts",
    "parallel": "tsx utils/parallelRun.ts",
    "eks:setup": "tsx utils/eksSetup.ts",
    "eks:history": "tsx utils/eksHistory.ts",
    "model:setup": "tsx utils/eksModel.ts",
    "preflight": "tsx utils/preflight.ts",
    "teach": "tsx utils/teach.ts",
    "validate": "tsx utils/validateFolder.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "node --import tsx --test unit/logic.test.ts unit/teach.test.ts unit/validate.test.ts unit/ollamaHost.test.ts unit/ollamaInstall.test.ts",
    "check": "npm run typecheck && npm run test:unit",
    "status": "tsx status-dashboard/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
