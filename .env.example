# Copy to .env (never commit it) and fill in on your own machine.
# Which environment to run: qa (default) or dev
TEST_ENV=qa

# QA login (qa-app.testable.cloud)
TESTABLE_EMAIL=
TESTABLE_PASSWORD=
# DEV login (dev-app.testable.cloud) — used when TEST_ENV=dev
TESTABLE_EMAIL_DEV=
TESTABLE_PASSWORD_DEV=

# Microsoft work account used by the AWS portal sign-in (S3 evidence)
# S3 evidence (QA-S3-Readonly temporary keys: AWS access portal -> Access keys). Expire after a few hours.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-2

# S3 bucket is picked from TEST_ENV: qa -> testable-qa-artifacts-759498976252, dev -> dev-bucket-us2 (override with S3_BUCKET)
# The AWS keys must be allowed to read that bucket (dev: dev-bucket-us2).

# Dummy commit before each run: yes = append a comment line to README.md of every branch and push it (new commit -> fresh analysis). Default: no.
# Needs git on this computer signed in to GitHub with write access to the repos.
DUMMY_PR=no

# Login way: normal (default, email + password) or okta (Sign in with SSO -> Okta). Okta uses OKTA_EMAIL/OKTA_PASSWORD if set, else TESTABLE_EMAIL/TESTABLE_PASSWORD.
LOGIN_MODE=normal
# OKTA_EMAIL=
# OKTA_PASSWORD=

# Teams notification: paste the Workflows webhook URL (Teams channel -> Workflows -> "Send webhook alerts to a channel"). Empty = no Teams messages.
# One message per branch: success note, or failure reason + small screenshot. Keep this URL secret.
TEAMS_WEBHOOK_URL=

# SharePoint upload: after each branch, its results folder is copied into this folder and OneDrive uploads it. Empty = off.
# In SharePoint open the day's folder (e.g. 22-10-2026) -> "Add shortcut to OneDrive", then paste the folder path from File Explorer. Change it every day.
SHAREPOINT_DIR=

# Optional: link to the branch folder in the Teams cards. Open the day's folder in SharePoint and paste the address from the browser address bar (not "Copy link"). Change it every day with SHAREPOINT_DIR.
SHAREPOINT_URL=

# Gate screenshots (step 14). Default off: only the gate values are read (the "UI value" column still works). on = also take the screenshots.
GATE_SHOTS=off

# Post-processing: background (default) = the S3 check, validators, bug drafts, SharePoint copy and Teams message of a finished branch run in a
# separate worker while the next branch is already executing on the platform. inline = everything inside the site test, one branch after the other.
POSTPROCESS=background

# SharePoint upload (permanent; replaces SHAREPOINT_DIR / SHAREPOINT_URL). Evidence goes to <Automation Evidences Dump>/<DD-MM-YYYY>/<branch> in the team library.
# EASIEST (no admin, nothing to put in .env): run  npm run sp:login  once, sign in with your own Microsoft work account in the browser that opens.
# The script then uploads with your session. If your company ends the session, run  npm run sp:login  again.
# OPTIONAL, for an Entra app registration made by an admin (token refreshes unattended): fill SP_TENANT_ID and SP_CLIENT_ID below; sp:login then does a code sign-in.
# Microsoft Graph details:
# Evidence goes to <SP_URL folder>/<DD-MM-YYYY>/<branch> in the team library. Values come from the Entra app registration (not secret).
# After setting them, each developer signs in ONCE:  npm run sp:login
SP_TENANT_ID=
SP_CLIENT_ID=
# Optional: another target folder (address-bar URL of the parent folder). Default: Automation Evidences Dump in Testable-ExecutionTeam.
# SP_URL=

# Second Testable account on the SAME PC (two terminals side by side). Add its login here, then start the second terminal with ACCOUNT=2
# (set ACCOUNT in the terminal, NOT in this file). It then uses its own saved session (.auth/user-2.json) and its own results folder (..._acct2).
# DEV site: TESTABLE_EMAIL_DEV_2 / TESTABLE_PASSWORD_DEV_2.
# TESTABLE_EMAIL_2=
# TESTABLE_PASSWORD_2=
# With both logins above filled, `npm run parallel` runs the branches of builds.json on both accounts at the same time:
# every account is a lane, and the next waiting branch goes to whichever account is free. LANES=1 (terminal) = first account only.

# QA EKS cluster access for the live log capture (optional). With the team's READ-ONLY cluster key below the capture works without a browser
# sign-in. It must be an IAM ACCESS KEY (id + secret), not the AWS access portal user name and password. The S3 keys above are never used for
# the cluster. EKS_AUTO=on without keys uses your own `aws sso login --profile qa-eks-ro` session; EKS_AUTO=off turns it off. Nothing here
# stops a run: if the cluster is not reachable it is skipped.
# EKS_AWS_ACCESS_KEY_ID=
# EKS_AWS_SECRET_ACCESS_KEY=
# EKS_AWS_SESSION_TOKEN=
# EKS_AUTO=on
# EKS_CLUSTER_NAME=qa-eks
# EKS_REGION=us-east-2

# QA EKS cluster logs (read-only). Sign in once with  aws configure sso --profile qa-eks-ro  ; after that the only line you need is:
# EKS_AUTO=on
# EKS_LIVE=off switches only the live log capture off. A read-only key (EKS_AWS_ACCESS_KEY_ID / EKS_AWS_SECRET_ACCESS_KEY) replaces the browser sign-in. Never put a password here.
# Pre-flight check before the first branch (also: npm run preflight). Default: only reports what is missing and what it skips.
# PREFLIGHT=strict stops the run when a check is FAIL (expired AWS keys, no SharePoint sign-in ...). PREFLIGHT=off skips the check.
# PREFLIGHT=strict
# Dry run of the post-processing: shows the SharePoint copy and the Teams card, uploads and sends nothing (also: npm run post -- "<folder>" --dry-run).
# POST_DRYRUN=1

# ---------------------------------------------------------------------------------------------------------------------------------------
# Advanced / optional settings (all have working defaults; set only when needed)
# Login and safety: prefer the saved sessions (npm run setup, npm run sp:login) to storing passwords here. The code can also read
#   AWS_PASSWORD, MICROSOFT_PASSWORD, GITHUB_TOKEN: leave them unset unless a step really needs them.
# Test run:      HEADLESS=1 (no visible browser) | PAGE_SCALE=1 (lower shows more of the page) | RUN_TIMEOUT_MIN=60 (wait limit per branch)
#                REPO / BRANCHES (override builds.json) | BUILDS_FILE (another branch list) | RUN_DIR (results folder) | ACCOUNT (second account lane)
#                LANES (number of parallel lanes) | PARALLEL_STAGGER_SEC=20 | REPO_SYNC_CAP_MIN=14 | CHROMIUM_PATH (own Chromium for the PDFs)
# Post-process:  POSTPROCESS=background|inline | POSTPROCESS_WAIT=off (the launcher waits itself) | BUG_REPORTS=off | BUG_PDF_PARALLEL=4
#                TEAMS_RESEND=1 (send a second complete card for the same run) | POST_DRYRUN=1 (preview only)
# S3:            S3_BUCKET, S3_ROOT, AWS_REGION, AWS_PROFILE (aws sso login) | S3_AWS_ACCOUNT, S3_AWS_ROLE (used by eks:setup help text)
#                S3_RESULTS_DIR + S3_FORCE (npm run s3 on an old results folder)
# Tool lists:    PY_IGNORE_TOOLS, JS_IGNORE_TOOLS, TS_IGNORE_TOOLS, CS_IGNORE_TOOLS, JAVA_IGNORE_TOOLS (comma list of tools the checker should not judge)
# QA EKS:        EKS_NAMESPACE, EKS_CLUSTER_NAME=qa-eks, EKS_REGION=us-east-2, EKS_AWS_PROFILE, EKS_SSO_START_URL, EKS_SSO_REGION, EKS_KUBECTL, EKS_AWS_CLI
#                EKS_LOGIN_WAIT_MIN=4 | EKS_HISTORY_SINCE=96h (npm run eks:history)
#                EKS_STUCK_STOP=off (never stop a stuck run early) | EKS_STUCK_MIN=10 | EKS_STUCK_WAITS=150
# SharePoint:    SP_URL (evidence folder link) | SP_DEBUG=1 (print every SharePoint call)
